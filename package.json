{
  "name": "wild-frontier-fps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:static": "node scripts/check-static.mjs",
    "preview": "python -m http.server 8000 --directory dist",
    "check:arms": "node scripts/check-weapon-posture.mjs && node scripts/check-weapon-hands.mjs",
    "check:field": "node scripts/check-field-chatter.mjs",
    "check:driving": "node scripts/check-drivable-terrain.mjs && node scripts/check-vehicles.mjs && node scripts/check-vehicle-water.mjs",
    "check:voices": "node scripts/check-combat-chatter.mjs && node scripts/check-vocal-reactions.mjs",
    "check:hits": "node scripts/check-bullet-collapse.mjs && node scripts/check-impact-motion.mjs",
    "check:ai": "node scripts/check-enemy-ai.mjs",
    "check:input": "node scripts/check-look-controls.mjs && node scripts/check-mobile-pause.mjs"
  },
  "description": "Restored complete Wild Frontier 3D FPS with local assets and GitHub Pages deployment",
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100"
  }
}
